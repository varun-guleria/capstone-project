# Required for AI-generated quizzes and feedback
GROQ_API_KEY=your_groq_key_here

# Required for AI-generated learning roadmaps
GROQ_API_KEY_ROADMAP=your_groq_key_here

PORT=5000

# Optional: defaults to Qwen 3.6 27B, a current Groq production model with
# JSON mode and strong multilingual planning/reasoning performance.
GROQ_MODEL=qwen/qwen3.6-27b
